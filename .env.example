# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-string-in-production

# Database
DB_PATH=./data/rafael.db

# Authentik OIDC
AUTHENTIK_ISSUER=https://your-authentik-instance/application/o/rafael-exhibit/
AUTHENTIK_CLIENT_ID=rafael-exhibit
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://your-domain/api/auth/callback

# Admin emails (comma-separated)
ADMIN_EMAILS=your@email.com
